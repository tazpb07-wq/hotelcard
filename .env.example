# Supabase project configuration (frontend - public/publishable keys only)
# Copie este arquivo para .env e preencha com os valores do seu projeto.
# Dashboard: Project Settings > Data API / API Keys

VITE_SUPABASE_PROJECT_ID="seu-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-publishable-key"
VITE_SUPABASE_URL="https://seu-project-ref.supabase.co"
